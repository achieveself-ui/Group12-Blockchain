# 复制本文件为 .env 后填写真实值；.env 已被 .gitignore 忽略，禁止提交。
# PowerShell: Copy-Item .env.example .env

# Sepolia 测试网 RPC 端点（注意必须是 sepolia，不是 mainnet）
# 例: https://eth-sepolia.g.alchemy.com/v2/REPLACE_WITH_YOUR_KEY
SEPOLIA_RPC_URL=REPLACE_WITH_YOUR_SEPOLIA_RPC_URL

# 专用测试钱包私钥：0x 开头 + 64 位十六进制，共 66 个字符
# 从 MetaMask「账户详情 → 导出私钥」获取；不要使用存有真实资产的钱包
DEPLOYER_PRIVATE_KEY=REPLACE_WITH_YOUR_PRIVATE_KEY
