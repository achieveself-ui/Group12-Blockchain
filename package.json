{
  "name": "defi-shield",
  "version": "0.1.0",
  "private": true,
  "description": "DeFi Shield course project: local teaching demo, never a public service",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "demo:b": "hardhat run scripts/b-dev/compare-local.js",
    "validate:b": "node scripts/b-dev/validate.js",
    "deploy:local": "hardhat run scripts/deploy-local.js --network localhost",
    "deploy:sepolia": "node --env-file-if-exists=.env ./node_modules/hardhat/internal/cli/cli.js run scripts/deploy-sepolia.js --network sepolia",
    "demo:setup": "hardhat run scripts/setup-demo.js --network localhost"
  },
  "devDependencies": {
    "node": "22.16.0",
    "hardhat": "2.26.3",
    "@nomicfoundation/hardhat-ethers": "3.0.8",
    "@nomicfoundation/hardhat-chai-matchers": "2.0.8",
    "ethers": "6.13.4",
    "chai": "4.5.0",
    "solc": "0.8.24"
  },
  "dependencies": { "@openzeppelin/contracts": "5.0.2" }
}
